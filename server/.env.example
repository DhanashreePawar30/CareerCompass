# ──────────────────────────────────────────
# CareerCompass Backend Configuration
# ──────────────────────────────────────────

# Server
PORT=5000

# OpenAI (for AI-powered FIRO-B synthesis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
# Only used by reasoning models (gpt-5+/gpt-6/o-series): low | medium | high
OPENAI_REASONING_EFFORT=low

# MongoDB (leave empty to use in-memory database for development)
# For production, use a MongoDB Atlas URI or local MongoDB instance:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/careercompass
MONGODB_URI=mongodb://127.0.0.1:27017/careercompass
